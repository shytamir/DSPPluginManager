<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DSPPluginManager.RM05CecilHandoff</AssemblyName>
    <RootNamespace>DSPPluginManager.RM05CecilHandoff</RootNamespace>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(ManagedDependencyDirectory)\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateProbeInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDependencyDirectory)\Mono.Cecil.dll')"
           Text="ManagedDependencyDirectory must identify the validated dependency runtime directory." />
  </Target>
</Project>
