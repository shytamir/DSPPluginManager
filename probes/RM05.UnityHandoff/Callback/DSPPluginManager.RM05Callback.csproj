<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DSPPluginManager.RM05Callback</AssemblyName>
    <RootNamespace>DSPPluginManager.RM05Callback</RootNamespace>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="DSPPluginManager.RM05Probe">
      <HintPath>$(RM05ProbeAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(DSPManagedDirectory)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateProbeInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RM05ProbeAssembly)')"
           Text="RM05ProbeAssembly must identify the compiled probe entry assembly." />
    <Error Condition="!Exists('$(DSPManagedDirectory)\UnityEngine.CoreModule.dll')"
           Text="DSPManagedDirectory must identify the supported game's Managed directory." />
  </Target>
</Project>
